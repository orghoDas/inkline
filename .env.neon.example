HOST=127.0.0.1
PORT=4173

# Neon runtime connection string. In the Neon Connect modal, enable pooling.
DATABASE_URL="postgresql://USER:PASSWORD@ENDPOINT-pooler.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Neon direct connection string. In the Neon Connect modal, disable pooling.
DIRECT_URL="postgresql://USER:PASSWORD@ENDPOINT.REGION.aws.neon.tech/DBNAME?sslmode=require&channel_binding=require"

# Development fallback is used unless EMAIL_PROVIDER=resend and RESEND_API_KEY are set.
EMAIL_PROVIDER=dev
EMAIL_FROM="Inkline <hello@example.com>"
RESEND_API_KEY=

# Comma-separated list. Set your own email here so your Neon account is an admin.
ADMIN_EMAILS=
