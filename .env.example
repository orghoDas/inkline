HOST=127.0.0.1
PORT=4173

# Postgres connection strings. For Neon, use the pooled URL for DATABASE_URL
# and the direct URL for DIRECT_URL so Prisma migrations can run safely.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/inkline?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/inkline?sslmode=require"

# Development fallback is used unless EMAIL_PROVIDER=resend and RESEND_API_KEY are set.
EMAIL_PROVIDER=dev
EMAIL_FROM="Inkline <hello@example.com>"
RESEND_API_KEY=

# Comma-separated list. The first registered user is also an admin locally.
ADMIN_EMAILS=
